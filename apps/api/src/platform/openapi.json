              "type": "string",
              "enum": ["synthetic", "business-records", "contact-data", "voice-recording"]
            }
          },
          "fallbackProviderId": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "providerId",
          "mode",
          "status",
          "region",
          "dataClasses",
          "fallbackProviderId",
          "version"
        ]
      },
      "Capability": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "llm",
              "embeddings",
              "chat",
              "contact-centre",
              "telephony",
              "speech-to-text",
              "text-to-speech",
              "email",
              "sms",
              "crm",
              "erp",
              "accounting",
              "ml-scoring",
              "workflow"
            ]
          },
          "label": {
            "type": "string"
          },
          "binding": {
            "$ref": "#/components/schemas/Binding"
          }
        },
        "required": ["capability", "label", "binding"]
      },
      "BindingUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "credentialRef": {
            "type": "string",
            "pattern": "^(?:fixture:[a-zA-Z][a-zA-Z0-9._-]{0,63}|vault://[a-zA-Z][a-zA-Z0-9._/-]{0,127})$",
            "writeOnly": true
          },
          "fallbackProviderId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          }
        },
        "required": ["providerId"]
      },
      "Provider": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerId": {
            "$ref": "#/components/schemas/Id"
          },
          "capability": {
            "type": "string",
            "enum": [
              "llm",
              "embeddings",
              "chat",
              "contact-centre",
              "telephony",
              "speech-to-text",
              "text-to-speech",
              "email",
              "sms",
              "crm",
              "erp",
              "accounting",
              "ml-scoring",
              "workflow"
            ]
