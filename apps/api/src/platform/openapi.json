            "enum": ["native", "byo", "premium"]
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": ["providerId", "capability", "name", "mode", "regions", "features", "notes"]
