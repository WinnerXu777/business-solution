                  "$ref": "#/components/schemas/Count"
                }
              },
              "required": ["module", "used", "allowance"]
            }
          }
        },
        "required": ["items", "totals"]
      },
      "ApprovalQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "type": "string",
            "enum": ["pending", "approved", "consumed", "rejected", "expired"]
