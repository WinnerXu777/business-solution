          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "maxItems": 50,
            "uniqueItems": true
          }
        },
        "required": ["kind", "name", "scopes"]
      },
