          "role": {
            "type": "string",
            "enum": ["reader", "operator", "approver", "admin"]
          },
          "workspaces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          }
        },
        "required": ["tenant", "actor", "role", "workspaces"]
      },
      "Module": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "moduleId": {
            "$ref": "#/components/schemas/ModuleId"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "allowance": {
            "$ref": "#/components/schemas/Count"
          },
          "used": {
            "$ref": "#/components/schemas/Count"
          },
          "windowStart": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "windowEnd": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "moduleId",
          "name",
          "description",
          "enabled",
          "allowance",
          "used",
          "windowStart",
          "windowEnd"
        ]
