      "ModuleUpdate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["enabled"]
      },
      "Binding": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "providerId": {
            "$ref": "#/components/schemas/Id"
          },
