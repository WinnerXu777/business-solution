      "ProviderQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "llm",
              "embeddings",
              "chat",
              "contact-centre",
              "telephony",
              "speech-to-text",
              "text-to-speech",
              "email",
              "sms",
              "crm",
              "erp",
              "accounting",
              "ml-scoring",
              "workflow"
            ]
          }
        },
        "required": []
      },
      "AuditQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "actorId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "state": {
            "type": "string",
            "enum": ["ok", "pending_approval", "denied", "failed", "unknown"]
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
          },
          "cursor": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,512}$"
          },
          "limit": {
            "type": "string",
            "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"
          }
        },
        "required": []
      },
      "AuditPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["items", "nextCursor"]
      },
      "UsageQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "enum": ["records", "procurement", "collections", "workflows", "insights", "ai"]
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
          }
        },
        "required": []
