  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Verified fixture identity token."
      }
    },
    "schemas": {
      "Id": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      },
      "Timestamp": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
      },
      "Count": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "Actor": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "kind": {
            "enum": ["person", "service"]
          }
        },
        "required": ["id", "kind"]
      },
      "ModuleId": {
        "enum": ["records", "procurement", "collections", "workflows", "insights", "ai"]
      },
      "AuditEntry": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "tenantId": {
            "$ref": "#/components/schemas/Id"
          },
          "actor": {
            "$ref": "#/components/schemas/Actor"
          },
          "source": {
            "enum": ["portal", "rest", "mcp", "chat", "browser_voice", "workflow", "worker"]
          },
          "tool": {
            "$ref": "#/components/schemas/Id"
          },
          "traceId": {
            "$ref": "#/components/schemas/Id"
          },
          "correlationId": {
            "$ref": "#/components/schemas/Id"
          },
          "actionId": {
            "$ref": "#/components/schemas/Id"
          },
          "policyVersion": {
            "$ref": "#/components/schemas/Id"
          },
          "state": {
            "enum": ["ok", "pending_approval", "denied", "failed", "unknown"]
          },
          "occurredAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": [
          "id",
          "tenantId",
          "actor",
          "source",
          "tool",
          "traceId",
          "correlationId",
          "actionId",
          "policyVersion",
          "state",
          "occurredAt"
        ]
      },
      "UsageCounterEvent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "tenantId": {
            "$ref": "#/components/schemas/Id"
          },
          "module": {
            "$ref": "#/components/schemas/ModuleId"
          },
          "outcomeId": {
            "$ref": "#/components/schemas/Id"
          },
          "unit": {
            "$ref": "#/components/schemas/UsageUnit"
          },
          "quantity": {
            "$ref": "#/components/schemas/Count"
          },
          "occurredAt": {
            "$ref": "#/components/schemas/Timestamp"
          }
        },
        "required": ["id", "tenantId", "module", "outcomeId", "unit", "quantity", "occurredAt"]
      },
      "UsageUnit": {
        "enum": ["actions", "messages", "tokens", "audio_seconds"]
      },
      "Approval": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
          },
          "tenantId": {
            "$ref": "#/components/schemas/Id"
          },
          "requestedBy": {
            "$ref": "#/components/schemas/Id"
          },
          "approverId": {
            "$ref": "#/components/schemas/Id"
          },
          "tool": {
            "$ref": "#/components/schemas/ApprovalAction"
          },
          "subjectId": {
            "$ref": "#/components/schemas/Id"
          },
          "materialHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceVersion": {
            "$ref": "#/components/schemas/Count"
          },
          "policyVersion": {
            "$ref": "#/components/schemas/Id"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/Timestamp"
          },
          "state": {
            "type": "string",
            "enum": ["pending", "approved", "consumed", "rejected", "expired"]
          }
        },
        "required": [
          "id",
          "tenantId",
          "requestedBy",
          "approverId",
          "tool",
          "subjectId",
          "materialHash",
          "sourceVersion",
          "policyVersion",
          "expiresAt",
          "state"
        ]
      },
      "ApprovalAction": {
        "enum": [
          "purchase.order.approve",
          "collections.email.send",
          "collections.voice.send",
          "collections.sms.send",
          "workflow.template.run"
        ]
      },
      "Workspace": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/components/schemas/Id"
